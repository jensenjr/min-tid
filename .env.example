# min-tid — environment variables. Copy to .env for local use; on Railway set them under
# the service's "Variables". Nothing here is needed for `npm run dev` + `npm run server:dev`.

# ─── Server (server/index.js) ─────────────────────────────────────────────────────────

# REQUIRED in production. Signs the login tokens. At least 32 random characters, e.g.
#   openssl rand -base64 48
# The server refuses to start with NODE_ENV=production if this is missing or a placeholder.
JWT_SECRET=

# Set by the Dockerfile. "production" serves dist/ and enforces JWT_SECRET.
# NODE_ENV=production

# Port. Default 3000 in production, 3001 in development. Railway sets PORT itself.
# PORT=3000

# Where accounts are stored (one JSON file — there is no database). Leave unset on Railway:
# the server uses the attached volume (RAILWAY_VOLUME_MOUNT_PATH/data.json), else
# /app/data/data.json. Without a volume, EVERY REDEPLOY DELETES ALL ACCOUNTS.
# Railway: add a Volume to the service with mount path /app/data.
# DATA_PATH=/app/data/data.json

# Set to 1 when DATA_PATH is on a disk that survives restarts outside Railway (e.g. the
# docker-compose bind mount), so GET /api/health reports storage "persistent".
# DATA_PERSISTENT=1

# Railway sets these automatically — do not set them yourself:
#   RAILWAY_VOLUME_MOUNT_PATH  (only when a volume is attached)
#   RAILWAY_ENVIRONMENT_NAME, RAILWAY_PROJECT_ID, RAILWAY_SERVICE_ID

# SMS recovery via 46elks. Without them the server logs the code instead of sending it
# (fine for development, not for production).
# ELKS_API_USERNAME=
# ELKS_API_PASSWORD=
# ELKS_FROM=MinTid

# SMS rate limits (defaults shown).
# SMS_RESEND_COOLDOWN_SEC=60
# SMS_MAX_PER_HOUR=3
# SMS_MAX_PER_DAY=10

# ─── Frontend (build time, Vite) ──────────────────────────────────────────────────────

# Only when the API is on another origin than the app. Default: same origin (/api).
# VITE_API_URL=https://api.example.com
